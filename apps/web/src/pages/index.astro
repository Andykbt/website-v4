import Section from "../layouts/Section.astro";
---

<Layout title="Andy Truong">
  <div class=" flex flex-col gap-16 mx-auto max-w-2xl py-16 px-6 md:py-24">

    <div class="flex flex-col gap-4 px-4">
      <h1 class="text-lg">Andy Truong</h1>
      <p class="text-muted-foreground">Software Engineer @ Fire Front Solutions</p>
    </div>

    <Section title="Work">
      <Card title="Fire Front Solutions" description="Software Engineer" date="Apr 22 - Present" href="https://www.firemapper.app/" />
      <Card title="SafetyCulture" description="Full Stack Software Engineer, Intern" date="Dec 21 - Feb 2022" href="https://safetyculture.com/" />
      <Card title="PC Market" description="Frontend Web Developer" date="Dec 20 - Dec 21" href="https://www.pcmarket.com.au/" />
    </Section>

    <Section title="Projects">
      <Card title="Ascend" description="React Native Climbing Progress Tracker" date="2025 - Present" href="https://www.ascendapp.xyz/" />
    </Section>

    <div class="border-t border-border pt-8 px-4">
      <div class="flex flex-row gap-8 text-sm">
        <Link href="https://www.linkedin.com/in/andy-truong-591449216/">LinkedIn</Link>
        <Link href="https://github.com/Andykbt">Github</Link>
        <Link href="mailto:andy.truong2001@gmail.com">Email</Link>
